{
  "apiInfo": {
    "name": "Remindabot User Management API",
    "version": "1.0.0",
    "baseUrl": "/api/v1/auth",
    "description": "Complete user management system with OTP-based authentication",
    "authentication": "JWT Bearer Token (for protected routes)",
    "contentType": "application/json"
  },
  "endpoints": [
    {
      "name": "Start Registration",
      "method": "POST",
      "path": "/start-registration",
      "description": "Start the registration process by sending OTP to email",
      "authentication": false,
      "rateLimit": "None",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "John Doe",
          "email": "john@example.com"
        },
        "validation": {
          "name": {
            "type": "string",
            "required": true,
            "minLength": 2,
            "maxLength": 50,
            "description": "User's full name"
          },
          "email": {
            "type": "string",
            "required": true,
            "format": "email",
            "description": "User's email address"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 201,
          "body": {
            "success": true,
            "message": "Registration OTP sent to your email. Please check your email and enter the OTP to complete registration.",
            "data": {
              "_id": "507f1f77bcf86cd799439011",
              "name": "John Doe",
              "email": "john@example.com",
              "role": "user",
              "avatar": "",
              "isActive": true,
              "isEmailVerified": false,
              "preferences": {
                "theme": "auto",
                "notifications": {
                  "email": true,
                  "push": true
                }
              },
              "createdAt": "2024-01-01T00:00:00.000Z",
              "updatedAt": "2024-01-01T00:00:00.000Z"
            }
          }
        },
        "error": {
          "statusCode": 400,
          "body": {
            "success": false,
            "error": "Validation failed",
            "details": [
              {
                "field": "email",
                "message": "Please provide a valid email address",
                "value": "invalid-email"
              }
            ]
          }
        }
      }
    },
    {
      "name": "Complete Registration",
      "method": "POST",
      "path": "/complete-registration",
      "description": "Complete registration by verifying OTP",
      "authentication": false,
      "rateLimit": "5 requests per 15 minutes",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "john@example.com",
          "otp": "123456"
        },
        "validation": {
          "email": {
            "type": "string",
            "required": true,
            "format": "email",
            "description": "User's email address"
          },
          "otp": {
            "type": "string",
            "required": true,
            "length": 6,
            "pattern": "^[0-9]+$",
            "description": "6-digit OTP received via email"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Registration completed successfully! Welcome to Remindabot.",
            "data": {
              "user": {
                "_id": "507f1f77bcf86cd799439011",
                "name": "John Doe",
                "email": "john@example.com",
                "role": "user",
                "avatar": "",
                "isActive": true,
                "isEmailVerified": true,
                "preferences": {
                  "theme": "auto",
                  "notifications": {
                    "email": true,
                    "push": true
                  }
                },
                "createdAt": "2024-01-01T00:00:00.000Z",
                "updatedAt": "2024-01-01T00:00:00.000Z"
              },
              "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
            }
          }
        },
        "error": {
          "statusCode": 401,
          "body": {
            "success": false,
            "error": "Invalid or expired OTP"
          }
        }
      }
    },
    {
      "name": "Send Login OTP",
      "method": "POST",
      "path": "/send-login-otp",
      "description": "Send OTP for login authentication",
      "authentication": false,
      "rateLimit": "5 requests per 15 minutes",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "john@example.com"
        },
        "validation": {
          "email": {
            "type": "string",
            "required": true,
            "format": "email",
            "description": "User's email address"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "OTP sent to your email"
          }
        },
        "error": {
          "statusCode": 404,
          "body": {
            "success": false,
            "error": "User not found"
          }
        }
      }
    },
    {
      "name": "Login with OTP",
      "method": "POST",
      "path": "/login-with-otp",
      "description": "Authenticate user with OTP and return JWT token",
      "authentication": false,
      "rateLimit": "5 requests per 15 minutes",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "john@example.com",
          "otp": "123456"
        },
        "validation": {
          "email": {
            "type": "string",
            "required": true,
            "format": "email",
            "description": "User's email address"
          },
          "otp": {
            "type": "string",
            "required": true,
            "length": 6,
            "pattern": "^[0-9]+$",
            "description": "6-digit OTP received via email"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Login successful",
            "data": {
              "user": {
                "_id": "507f1f77bcf86cd799439011",
                "name": "John Doe",
                "email": "john@example.com",
                "role": "user",
                "avatar": "",
                "isActive": true,
                "isEmailVerified": true,
                "lastLogin": "2024-01-01T00:00:00.000Z",
                "preferences": {
                  "theme": "auto",
                  "notifications": {
                    "email": true,
                    "push": true
                  }
                },
                "createdAt": "2024-01-01T00:00:00.000Z",
                "updatedAt": "2024-01-01T00:00:00.000Z"
              },
              "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
            }
          }
        },
        "error": {
          "statusCode": 401,
          "body": {
            "success": false,
            "error": "Invalid or expired OTP"
          }
        }
      }
    },
    {
      "name": "Get Current User",
      "method": "GET",
      "path": "/me",
      "description": "Get current authenticated user's profile",
      "authentication": true,
      "rateLimit": "None",
      "request": {
        "headers": {
          "Authorization": "Bearer <jwt_token>"
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "data": {
              "_id": "507f1f77bcf86cd799439011",
              "name": "John Doe",
              "email": "john@example.com",
              "role": "user",
              "avatar": "",
              "isActive": true,
              "isEmailVerified": true,
              "lastLogin": "2024-01-01T00:00:00.000Z",
              "preferences": {
                "theme": "auto",
                "notifications": {
                  "email": true,
                  "push": true
                }
              },
              "createdAt": "2024-01-01T00:00:00.000Z",
              "updatedAt": "2024-01-01T00:00:00.000Z"
            }
          }
        },
        "error": {
          "statusCode": 401,
          "body": {
            "success": false,
            "error": "You are not logged in. Please log in to get access."
          }
        }
      }
    },
    {
      "name": "Update Profile",
      "method": "PUT",
      "path": "/profile",
      "description": "Update current user's profile information",
      "authentication": true,
      "rateLimit": "None",
      "request": {
        "headers": {
          "Authorization": "Bearer <jwt_token>",
          "Content-Type": "application/json"
        },
        "body": {
          "name": "John Smith",
          "avatar": "https://example.com/avatar.jpg",
          "preferences": {
            "theme": "dark",
            "notifications": {
              "email": true,
              "push": false
            }
          }
        },
        "validation": {
          "name": {
            "type": "string",
            "required": false,
            "minLength": 2,
            "maxLength": 50,
            "description": "User's full name"
          },
          "avatar": {
            "type": "string",
            "required": false,
            "description": "URL to user's avatar image"
          },
          "preferences": {
            "type": "object",
            "required": false,
            "properties": {
              "theme": {
                "type": "string",
                "enum": ["light", "dark", "auto"],
                "description": "User's preferred theme"
              },
              "notifications": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "boolean",
                    "description": "Email notification preference"
                  },
                  "push": {
                    "type": "boolean",
                    "description": "Push notification preference"
                  }
                }
              }
            }
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Profile updated successfully",
            "data": {
              "_id": "507f1f77bcf86cd799439011",
              "name": "John Smith",
              "email": "john@example.com",
              "role": "user",
              "avatar": "https://example.com/avatar.jpg",
              "isActive": true,
              "isEmailVerified": true,
              "preferences": {
                "theme": "dark",
                "notifications": {
                  "email": true,
                  "push": false
                }
              },
              "createdAt": "2024-01-01T00:00:00.000Z",
              "updatedAt": "2024-01-01T00:00:00.000Z"
            }
          }
        },
        "error": {
          "statusCode": 400,
          "body": {
            "success": false,
            "error": "Validation failed",
            "details": [
              {
                "field": "name",
                "message": "Name must be at least 2 characters long",
                "value": "J"
              }
            ]
          }
        }
      }
    },
    {
      "name": "Logout",
      "method": "POST",
      "path": "/logout",
      "description": "Logout current user and clear authentication",
      "authentication": true,
      "rateLimit": "None",
      "request": {
        "headers": {
          "Authorization": "Bearer <jwt_token>"
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Logged out successfully"
          }
        }
      }
    },
    {
      "name": "Deactivate Account",
      "method": "DELETE",
      "path": "/deactivate",
      "description": "Deactivate current user's account",
      "authentication": true,
      "rateLimit": "None",
      "request": {
        "headers": {
          "Authorization": "Bearer <jwt_token>"
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Account deactivated successfully"
          }
        }
      }
    },
    {
      "name": "Resend Registration OTP",
      "method": "POST",
      "path": "/resend-registration-otp",
      "description": "Resend registration OTP to user's email",
      "authentication": false,
      "rateLimit": "5 requests per 15 minutes",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "john@example.com"
        },
        "validation": {
          "email": {
            "type": "string",
            "required": true,
            "format": "email",
            "description": "User's email address"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Registration OTP resent to your email"
          }
        },
        "error": {
          "statusCode": 400,
          "body": {
            "success": false,
            "error": "Email is already verified"
          }
        }
      }
    },
    {
      "name": "Resend Login OTP",
      "method": "POST",
      "path": "/resend-login-otp",
      "description": "Resend login OTP to user's email",
      "authentication": false,
      "rateLimit": "5 requests per 15 minutes",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "john@example.com"
        },
        "validation": {
          "email": {
            "type": "string",
            "required": true,
            "format": "email",
            "description": "User's email address"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "OTP resent to your email"
          }
        },
        "error": {
          "statusCode": 403,
          "body": {
            "success": false,
            "error": "Please verify your email before logging in"
          }
        }
      }
    },
    {
      "name": "Refresh Token",
      "method": "POST",
      "path": "/refresh-token",
      "description": "Refresh JWT token for current user",
      "authentication": true,
      "rateLimit": "None",
      "request": {
        "headers": {
          "Authorization": "Bearer <jwt_token>"
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Token refreshed successfully",
            "data": {
              "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
            }
          }
        }
      }
    },
    {
      "name": "Verify Email",
      "method": "GET",
      "path": "/verify-email/:token",
      "description": "Verify user's email address using verification token",
      "authentication": false,
      "rateLimit": "None",
      "request": {
        "params": {
          "token": {
            "type": "string",
            "required": true,
            "description": "Email verification token"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Email verified successfully"
          }
        },
        "error": {
          "statusCode": 400,
          "body": {
            "success": false,
            "error": "Invalid or expired verification token"
          }
        }
      }
    },
    {
      "name": "Resend Verification Email",
      "method": "POST",
      "path": "/resend-verification",
      "description": "Resend email verification link to user",
      "authentication": false,
      "rateLimit": "5 requests per 15 minutes",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "john@example.com"
        },
        "validation": {
          "email": {
            "type": "string",
            "required": true,
            "format": "email",
            "description": "User's email address"
          }
        }
      },
      "response": {
        "success": {
          "statusCode": 200,
          "body": {
            "success": true,
            "message": "Verification email sent successfully"
          }
        },
        "error": {
          "statusCode": 400,
          "body": {
            "success": false,
            "error": "Email is already verified"
          }
        }
      }
    }
  ],
  "errorCodes": {
    "400": "Bad Request - Validation failed or invalid input",
    "401": "Unauthorized - Invalid credentials or token",
    "403": "Forbidden - Account deactivated or email not verified",
    "404": "Not Found - User not found",
    "423": "Locked - Account temporarily locked due to multiple failed attempts",
    "429": "Too Many Requests - Rate limit exceeded",
    "500": "Internal Server Error - Server error"
  },
  "securityFeatures": {
    "rateLimiting": {
      "authEndpoints": "5 requests per 15 minutes",
      "general": "50 requests per 15 minutes"
    },
    "accountLockout": {
      "failedOTPAttempts": 5,
      "lockoutDuration": "30 minutes"
    },
    "tokenExpiration": "7 days",
    "otpExpiration": "10 minutes",
    "emailVerificationExpiration": "24 hours"
  },
  "userModel": {
    "fields": {
      "_id": "ObjectId - Unique user identifier",
      "name": "String - User's full name (2-50 characters)",
      "email": "String - User's email address (unique, lowercase)",
      "role": "String - User role (user, admin, moderator)",
      "avatar": "String - URL to user's avatar image",
      "isActive": "Boolean - Account active status",
      "isEmailVerified": "Boolean - Email verification status",
      "lastLogin": "Date - Last login timestamp",
      "preferences": {
        "theme": "String - UI theme preference (light, dark, auto)",
        "notifications": {
          "email": "Boolean - Email notification preference",
          "push": "Boolean - Push notification preference"
        }
      },
      "createdAt": "Date - Account creation timestamp",
      "updatedAt": "Date - Last update timestamp"
    },
    "sensitiveFields": {
      "registrationOTPToken": "Hashed registration OTP",
      "registrationOTPExpires": "Registration OTP expiration",
      "registrationOTPAttempts": "Failed registration OTP attempts",
      "otpToken": "Hashed login OTP",
      "otpExpires": "Login OTP expiration",
      "otpAttempts": "Failed login OTP attempts",
      "emailVerificationToken": "Hashed email verification token",
      "emailVerificationExpires": "Email verification expiration",
      "loginAttempts": "Failed login attempts",
      "lockUntil": "Account lock expiration"
    }
  },
  "frontendIntegration": {
    "authenticationFlow": [
      "1. User enters email and name",
      "2. Call /start-registration",
      "3. User receives OTP via email",
      "4. User enters OTP",
      "5. Call /complete-registration",
      "6. Registration complete"
    ],
    "loginFlow": [
      "1. User enters email",
      "2. Call /send-login-otp",
      "3. User receives OTP via email",
      "4. User enters OTP",
      "5. Call /login-with-otp",
      "6. Store JWT token",
      "7. Use token for authenticated requests"
    ],
    "tokenManagement": {
      "storage": "localStorage or secure cookie",
      "header": "Authorization: Bearer <token>",
      "refresh": "Call /refresh-token before token expires",
      "logout": "Call /logout and clear stored token"
    },
    "errorHandling": {
      "401": "Redirect to login page",
      "403": "Show account status message",
      "423": "Show lockout message with countdown",
      "429": "Show rate limit message",
      "validation": "Display field-specific error messages"
    }
  }
}
